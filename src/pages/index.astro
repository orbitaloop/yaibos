---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ConceptIllustrations from '../components/ConceptIllustrations.astro';
import SopCockpitDemo from '../components/SopCockpitDemo.astro';
import Principles from '../components/Principles.astro';
import Inspirations from '../components/Inspirations.astro';
import ImplementationsScorecard from '../components/ImplementationsScorecard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import MyVideoAskSection from '../components/MyVideoAskSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="YAIBOS: The Sovereign AI Operating System for Small Business"
  description="Open specification for an integrated business AI harness: 1-click SOP execution, BYO subscription auth, team second brain with RBAC, and modular plugins.">
  <Header activePage="home" />

  <main>
    <Hero />
    <ConceptIllustrations />
    <SopCockpitDemo />
    <Principles />
    <Inspirations />

    <!-- Market Scorecard Preview Section -->
    <ImplementationsScorecard />

    <!-- Open Spec Callout Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto elegant-card rounded-2xl p-8 sm:p-12 border border-blue-200 bg-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xs">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-[11px] font-mono border border-blue-200 bg-blue-50 text-blue-700">
            <span>OPEN STANDARD & SCHEMAS</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 font-sans">
            Ready to implement or inspect the complete RFC specification?
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            YAIBOS is published as an open architectural specification under CC-BY-4.0. Access the complete technical schemas, SOP YAML manifests, telemetry data structures, and security guarantees.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0 font-mono text-xs">
          <a
            href="/spec"
            class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all text-center shadow-xs">
            VIEW FULL SPEC (RFC-01) →
          </a>
          <a
            href="/about"
            class="px-6 py-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 transition-all text-center font-semibold shadow-xs">
            ABOUT SAMUEL & THE STORY
          </a>
        </div>
      </div>
    </section>

    <!-- Newsletter Card -->
    <NewsletterSignup variant="card" />

    <!-- Async VideoAsk Line -->
    <MyVideoAskSection />
  </main>

  <Footer />
</BaseLayout>

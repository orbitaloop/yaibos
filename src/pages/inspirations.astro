---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import MyVideoAskSection from '../components/MyVideoAskSection.astro';
import Footer from '../components/Footer.astro';

import { inspirations as INSPIRATIONS, inspirationsReviewedOn, inspirationsReviewedLabel } from '../data/inspirations';

---

<BaseLayout
  title="Inspirations & Sources Behind YAIBOS"
  description="The books, frameworks and case studies behind YAIBOS, with original sources and a clear explanation of how each informs the specification.">
  <Header activePage="inspirations" />

  <main class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-6xl mx-auto space-y-16">

      <!-- Hero Header -->
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-mono text-blue-700 shadow-2xs">
          <span class="font-semibold">INSPIRATIONS & SOURCES</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 font-sans leading-tight">
          Ideas behind YAIBOS
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-light font-sans">
          YAIBOS draws on personal knowledge management, open files and practical agent workflows. These are the people and published projects we learn from, with links to their original work.
        </p>

        <p class="text-sm text-slate-600 leading-relaxed font-sans bg-slate-50 p-4 rounded-xl border border-slate-200">
          The summaries describe the cited work. “In YAIBOS” explains our own application of those ideas. These are editorial summaries, not quotations or endorsements.
        </p>
        <p class="text-sm text-slate-500">
          Sources reviewed <time datetime={inspirationsReviewedOn}>{inspirationsReviewedLabel}</time>.
        </p>
      </div>

      <!-- Conceptual Synthesis Pillars Strip -->
      <div class="grid md:grid-cols-3 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-blue-50/50 border border-blue-200/80 space-y-3">
          <span class="text-xs font-mono text-blue-700 uppercase font-bold tracking-wider block">
            01 · Sovereign Memory
          </span>
          <h2 class="text-lg font-bold text-slate-900 font-sans">
            Second Brains & Open Files
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Tiago Forte offers project-based organization. Nick Milo teaches connected notes. Eliott Meunier demonstrates an agent working with a second brain. YAIBOS combines these ideas in open files.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-200/80 space-y-3">
          <span class="text-xs font-mono text-emerald-800 uppercase font-bold tracking-wider block">
            02 · Executable Skills
          </span>
          <h2 class="text-lg font-bold text-slate-900 font-sans">
            Context, Tools & Skills
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Nate Herk’s Four Cs and Meta’s case study describe context, tool connections and reusable capabilities. YAIBOS uses these as practical references for business skills.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-amber-50/50 border border-amber-200/80 space-y-3">
          <span class="text-xs font-mono text-amber-900 uppercase font-bold tracking-wider block">
            03 · Ongoing Maintenance
          </span>
          <h2 class="text-lg font-bold text-slate-900 font-sans">
            Memory That Stays Useful
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Karpathy’s LLM Wiki describes periodic checks on a maintained knowledge base. Iwo Szapar’s MemoryOS offers workspace health checks and durable memory. Both inform our approach to maintenance.
          </p>
        </div>
      </div>

      <!-- Pioneers Detailed Directory -->
      <section class="space-y-8 pt-6">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-200">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 font-sans">
              People and published work
            </h2>
            <p class="text-xs text-slate-500 mt-1 font-sans">
              Original sources, followed by their relevance to YAIBOS.
            </p>
          </div>
          <span class="text-xs font-mono text-slate-500">{INSPIRATIONS.length} profiles</span>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {INSPIRATIONS.map((item) => (
            <article id={item.id} class="scroll-mt-24 elegant-card rounded-2xl p-6 sm:p-7 border border-slate-200/90 bg-white flex flex-col justify-between hover:border-blue-300 transition-all group shadow-xs hover:shadow-md">
              <div class="space-y-4">
                
                <!-- Profile Header -->
                <div class="flex items-start gap-4">
                  <img 
                    src={item.avatar} 
                    alt={item.name}
                    class={`w-16 h-16 rounded-2xl object-cover border border-slate-200 shadow-xs group-hover:border-blue-500 transition-colors shrink-0 ${item.isLogo ? 'p-2 bg-[#0866FF]/5' : ''}`}
                    loading="lazy"
                  />
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors font-sans">
                        {item.name}
                      </h3>
                      <a 
                        href={item.link} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="text-xs font-mono text-blue-600 hover:underline flex items-center gap-0.5 shrink-0"
                        title={`Visit ${item.name}`}>
                        <span>{item.isLogo ? 'article' : 'website'}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                    <p class="text-xs text-slate-500 leading-relaxed mt-1 font-sans">
                      {item.role}
                    </p>
                    <div class="mt-2">
                      <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                        {item.framework}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Contribution & Background -->
                <div class="text-sm text-slate-600 leading-relaxed font-sans space-y-2 pt-1">
                  <p>{item.contribution}</p>
                </div>

                <div class="pt-2">
                  <h4 class="text-xs font-semibold text-slate-900 mb-2">Original sources</h4>
                  <ul class="space-y-2 text-sm">
                    {item.sources.map((source) => (
                      <li>
                        <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline">
                          {source.label} <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Direct Connection to YAIBOS Spec -->
              <div class="mt-5 p-4 rounded-xl border border-blue-100 bg-blue-50/30">
                <h4 class="text-sm text-blue-700 font-semibold mb-1">In YAIBOS</h4>
                <p class="text-slate-700 text-sm leading-relaxed">{item.yaibosConnection}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <aside class="p-6 rounded-xl border border-slate-200 bg-slate-50 space-y-2">
        <h2 class="text-lg font-semibold text-slate-900">A separate reference for open files</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          <a href="https://stephango.com/file-over-app" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-medium hover:underline">Steph Ango’s “File over app” essay ↗</a>
          argues for durable files in accessible formats under their owner’s control. This is the direct reference for that principle, separate from Tiago Forte’s organization methods and Nick Milo’s linked-note teaching.
        </p>
      </aside>

      <!-- Synthesis Map Box -->
      <section class="p-8 sm:p-10 rounded-3xl bg-slate-900 text-slate-200 space-y-6 shadow-xl">
        <div class="max-w-2xl space-y-2">
          <span class="text-xs font-mono text-blue-400 uppercase tracking-widest font-semibold">
            Architectural Synthesis
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white font-sans">
            What YAIBOS combines
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-sans">
            Base describes the file-based system Samuel uses today. Cockpit and Team specify optional layers to implement; they are not released YAIBOS applications.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 font-mono text-xs pt-2">
          <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700/80 space-y-2">
            <span class="text-[10px] text-blue-400 uppercase font-bold">1. Sovereign Memory</span>
            <div class="font-bold text-white text-sm">Open Markdown Files</div>
            <p class="text-[11px] text-slate-400 font-sans">
              Context and skills in Markdown. View and edit them with Obsidian or another text editor.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700/80 space-y-2">
            <span class="text-[10px] text-emerald-400 uppercase font-bold">2. Skills for Business</span>
            <div class="font-bold text-white text-sm">Business Skill Outputs</div>
            <p class="text-[11px] text-slate-400 font-sans">
              Reusable instructions, with scripts and resources when needed, run through a supported harness.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700/80 space-y-2">
            <span class="text-[10px] text-amber-400 uppercase font-bold">3. Execution</span>
            <div class="font-bold text-white text-sm">Bring Your Own Account</div>
            <p class="text-[11px] text-slate-400 font-sans">
              Use official subscription access or your own API key. Model access, limits and costs depend on the harness and plan.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700/80 space-y-2">
            <span class="text-[10px] text-purple-400 uppercase font-bold">4. Optional Layers</span>
            <div class="font-bold text-white text-sm">Cockpit & Team</div>
            <p class="text-[11px] text-slate-400 font-sans">
              Proposed dashboard controls and enforced team permissions, with implementation requirements in the spec.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
          <span class="text-slate-400">Published under Creative Commons CC-BY-4.0</span>
          <a
            href="/spec"
            class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-bold transition-all flex items-center gap-2">
            <span>READ THE SPEC</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <!-- Propose an Inspiration Callout -->
      <section class="p-8 rounded-2xl border border-blue-200 bg-blue-50/40 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <h2 class="text-xl font-bold text-slate-900 font-sans">
            Suggest a source or a correction
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Share a relevant book, original article, open-source project or case study. Corrections to names, dates and attributions are welcome too.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0 font-mono text-xs">
          <a
            href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-center shadow-xs">
            PROPOSE A REFERENCE ↗
          </a>
          <a
            href="https://github.com/orbitaloop/yaibos"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-center font-semibold shadow-xs">
            GITHUB REPO ↗
          </a>
        </div>
      </section>

      <!-- Newsletter -->
      <NewsletterSignup variant="card" />

      <!-- Async VideoAsk Line -->
      <MyVideoAskSection />

    </div>
  </main>

  <Footer />
</BaseLayout>

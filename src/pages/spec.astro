---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import MyVideoAskSection from '../components/MyVideoAskSection.astro';
import Footer from '../components/Footer.astro';
// Rendered straight from the repo root SPEC.md: edit the spec there, never here.
import { Content } from '../../SPEC.md';
---

<BaseLayout
  title="YAIBOS Specification v1.1 draft"
  description="YAIBOS implementation profiles: a portable file-based Base, an optional skills dashboard, and Team permissions. Benefits, dependencies and exit paths for each level.">
  <Header activePage="spec" />

  <main class="py-12 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="flex flex-wrap items-center gap-3 pb-6 mb-10 border-b border-slate-200 text-sm">
        <button
          id="copy-spec-btn"
          type="button"
          class="px-4 py-2 rounded-lg bg-slate-900 text-white font-medium hover:bg-slate-800 transition-colors">
          Copy as Markdown
        </button>
        <a href="/SPEC.md" class="px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-800 transition-colors">
          Raw SPEC.md
        </a>
        <a
          href="https://github.com/orbitaloop/yaibos/blob/main/SPEC.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-800 transition-colors">
          Comment on GitHub ↗
        </a>
        <span id="copy-status" class="hidden text-emerald-700 text-sm">Copied.</span>
      </div>

      <article class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-h1:text-4xl prose-h1:tracking-tight prose-h2:mt-14 prose-h2:pt-8 prose-h2:border-t prose-h2:border-slate-200 prose-pre:text-[13px] prose-code:before:content-none prose-code:after:content-none prose-table:text-sm">
        <Content />
      </article>
    </div>
  </main>

  <NewsletterSignup variant="card" />
  <MyVideoAskSection />
  <Footer />
</BaseLayout>

<script is:inline>
  document.getElementById('copy-spec-btn')?.addEventListener('click', async () => {
    const res = await fetch('/SPEC.md');
    await navigator.clipboard.writeText(await res.text());
    const status = document.getElementById('copy-status');
    status.classList.remove('hidden');
    setTimeout(() => status.classList.add('hidden'), 3000);
  });
</script>

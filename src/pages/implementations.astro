---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ImplementationsScorecard from '../components/ImplementationsScorecard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import MyVideoAskSection from '../components/MyVideoAskSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="YAIBOS implementation scorecard: tools and gaps"
  description="Comparative evaluation of agent harnesses, second brains, and LLMOps tools against the YAIBOS sovereign small-business standard.">
  <Header activePage="implementations" />

  <main>
    <!-- Top Hero Section -->
    <section class="pt-20 pb-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">

          <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 font-sans leading-tight">
            How existing tools compare
          </h1>

          <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed font-light">
            We evaluate active agent harnesses, visual agent platforms, and AI second-brain systems against the YAIBOS sovereign criteria.
          </p>

          <p class="mt-2 text-slate-500 text-xs sm:text-sm leading-relaxed">
            Ratings show how each tool fits the business needs in the YAIBOS specification. They do not measure overall project quality or value to developers.
          </p>

          <div class="mt-6 flex flex-wrap gap-4 font-mono text-xs text-slate-500">
            <span class="flex items-center gap-1.5 font-semibold text-slate-700">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
              12 projects graded
            </span>
            <span>•</span>
            <span>Last updated: September 2026</span>
            <span>•</span>
            <a href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos" class="text-blue-600 hover:underline">
              Suggest a project to review ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The Scorecard Component -->
    <ImplementationsScorecard />

    <!-- Strategic Takeaways -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl mb-8">
          <h2 class="text-2xl font-bold text-slate-900 font-mono">
            Where the gaps are
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Common gaps for founder-led small businesses.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 text-xs font-mono">
          <div class="p-6 rounded-xl border border-slate-200 bg-white shadow-xs">
            <span class="text-blue-600 font-bold block mb-2 text-sm">1. Tools built for developers</span>
            <p class="text-slate-600 leading-relaxed font-sans text-sm">
              Most frameworks expect users to know Git, Docker, and the terminal. That makes them difficult for non-technical staff to use.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-slate-200 bg-white shadow-xs">
            <span class="text-emerald-700 font-bold block mb-2 text-sm">2. Unpredictable API costs</span>
            <p class="text-slate-600 leading-relaxed font-sans text-sm">
              Agent loops can run up metered API costs when team members use them without spending limits. Bring-your-own-subscription (BYOS) access gives each person a way to use their existing AI plan.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-slate-200 bg-white shadow-xs">
            <span class="text-amber-800 font-bold block mb-2 text-sm">3. Context and team access</span>
            <p class="text-slate-600 leading-relaxed font-sans text-sm">
              Context may sit in vector databases that people cannot inspect, or in personal note apps without team permissions or agent runners.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-slate-200 bg-white shadow-xs">
            <span class="text-purple-700 font-bold block mb-2 text-sm">4. Maintaining a custom runtime</span>
            <p class="text-slate-600 leading-relaxed font-sans text-sm">
              A custom agent runtime needs its own tool drivers, plugins, and fixes. Building on an open-source harness such as DeepSeek Harness or OpenCode gives projects access to shared plugins, adapters, and security patches.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter Card -->
    <NewsletterSignup variant="card" />

    <MyVideoAskSection />
  </main>

  <Footer />
</BaseLayout>

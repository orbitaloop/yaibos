---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ImplementationsScorecard from '../components/ImplementationsScorecard.astro';
import MyVideoAskSection from '../components/MyVideoAskSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="FAIBOS Implementation Scorecard: Market Landscape & Gaps"
  description="Comparative evaluation of agent harnesses, second brains, and LLMOps tools against the FAIBOS sovereign small-business standard.">
  <Header activePage="implementations" />

  <main>
    <!-- Top Hero Section -->
    <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 border-b border-white/10 bg-[#08090d]">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#00f2fe]/30 bg-[#00f2fe]/10 text-xs font-mono text-[#00f2fe] mb-4">
            <span>LIVE COMPARATIVE RADAR</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white font-sans">
            Market Implementations & Gap Analysis
          </h1>

          <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed font-light">
            We evaluate active agent harnesses, visual LLM orchestrators, and AI second-brain systems against the FAIBOS sovereign criteria. Why does no single tool on the market yet satisfy all six pillars?
          </p>

          <div class="mt-6 flex flex-wrap gap-4 font-mono text-xs text-slate-400">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              8 Core Projects Graded
            </span>
            <span>•</span>
            <span>Last Updated: September 2026</span>
            <span>•</span>
            <a href="https://contact.samuelmichelot.com/?lang=en&source_site=faibos" class="text-[#00f2fe] hover:underline">
              Submit a Project for Grading ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The Scorecard Component -->
    <ImplementationsScorecard />

    <!-- Strategic Takeaways -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/10 bg-[#06070a]">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white font-mono mb-8">
          // KEY STRATEGIC TAKEAWAYS
        </h2>

        <div class="grid md:grid-cols-3 gap-6 text-xs font-mono">
          <div class="p-6 rounded-xl border border-white/10 bg-[#0c0e14]">
            <span class="text-[#00f2fe] font-bold block mb-2">1. The Developer Bias</span>
            <p class="text-slate-300 leading-relaxed font-sans text-sm">
              Most frameworks assume users are software engineers with Git workflows, Docker, and terminal comfort. Non-technical staff are completely alienated by current agent tooling.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/10 bg-[#0c0e14]">
            <span class="text-emerald-400 font-bold block mb-2">2. The Token Shock Trap</span>
            <p class="text-slate-300 leading-relaxed font-sans text-sm">
              Metered API architectures force founders to shoulder uncapped financial liabilities when team members trigger agent loops. BYOS authentication is an existential requirement.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/10 bg-[#0c0e14]">
            <span class="text-amber-400 font-bold block mb-2">3. The Knowledge Island</span>
            <p class="text-slate-300 leading-relaxed font-sans text-sm">
              Tools either store context in black-box vector databases that humans cannot inspect, or in personal note-taking apps that lack multi-user team permissions and agent runners.
            </p>
          </div>
        </div>
      </div>
    </section>

    <MyVideoAskSection />
  </main>

  <Footer />
</BaseLayout>

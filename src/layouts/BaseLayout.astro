---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "YAIBOS: Sovereign AI Operating System for Small Business",
  description = "Open specification for a sovereign AI harness: 1-click SOP execution, Bring Your Own Subscription auth, team second brain with role permissions, and modular plugins.",
  canonicalUrl = Astro.url.href,
} = Astro.props;

// Ensure no em dashes in public title or metadata
const cleanTitle = title.replace(/—/g, ':').replace(/–/g, '-');
const cleanDescription = description.replace(/—/g, ',').replace(/–/g, '-');
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-white text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://yaibos.com/images/yaibos-logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content="https://yaibos.com/images/yaibos-logo.png" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">
    <!-- Subtle architectural paper grid background -->
    <div class="pointer-events-none fixed inset-0 paper-grid opacity-70 z-0"></div>
    <div class="pointer-events-none fixed top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[450px] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.04),transparent_70%)] z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "FAIBOS — Sovereign AI Operating System for Small Business",
  description = "Open specification for a sovereign AI harness: 1-click SOP execution, BYO subscription auth, team second brain with RBAC, and modular plugins.",
  canonicalUrl = Astro.url.href,
} = Astro.props;

// Ensure no em dashes in public title or metadata
const cleanTitle = title.replace(/—/g, ':').replace(/–/g, '-');
const cleanDescription = description.replace(/—/g, ',').replace(/–/g, '-');
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#08090d] text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#08090d] text-slate-200 antialiased selection:bg-[#00f2fe] selection:text-black">
    <!-- Subtle technical grid background -->
    <div class="pointer-events-none fixed inset-0 tech-grid opacity-60 z-0"></div>
    <div class="pointer-events-none fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-[radial-gradient(ellipse_at_top,rgba(0,242,254,0.06),transparent_70%)] z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>

---
import { inspirations as INSPIRATIONS } from '../data/inspirations';
---

<section id="inspirations" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-white">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-200 bg-slate-50 text-xs font-mono text-slate-700 mb-3">
        <span>INSPIRATIONS & SOURCES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 font-sans">
        Ideas behind YAIBOS
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed">
        These books, teaching frameworks and case studies inform YAIBOS. Each profile links to the original work and explains what we take from it.
      </p>
    </div>

    <!-- Inspirations Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {INSPIRATIONS.map((item) => (
        <article class="elegant-card rounded-xl p-6 border border-slate-200/90 bg-white flex flex-col justify-between hover:border-blue-300 transition-all group">
          <div>
            <!-- Top Avatar & Identity -->
            <div class="flex items-start gap-4 mb-4">
              <div class="relative shrink-0">
                <img 
                  src={item.avatar} 
                  alt={item.name}
                  class={`w-14 h-14 rounded-xl object-cover border border-slate-200 shadow-xs group-hover:border-blue-500 transition-colors ${item.isLogo ? 'p-1.5 bg-[#0866FF]/5' : ''}`}
                  loading="lazy"
                />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                    {item.name}
                  </h3>
                  <a 
                    href={item.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-xs font-mono text-blue-700 hover:underline transition-colors flex items-center gap-0.5 shrink-0"
                    title={`Visit ${item.name}`}>
                    <span>{item.isLogo ? 'article' : 'website'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <p class="text-xs text-slate-500 leading-relaxed mt-1">
                  {item.role}
                </p>
              </div>
            </div>

            <!-- Contribution Description -->
            <p class="text-sm text-slate-600 leading-relaxed font-sans mb-4">
              {item.summary}
            </p>
          </div>

          <div class="space-y-3">
            <p class="text-sm text-slate-700 leading-relaxed">
              <span class="font-semibold">In YAIBOS: </span>{item.yaibosConnection}
            </p>
            <a href={`/inspirations#${item.id}`} aria-label={`Sources and details for ${item.name}`} class="text-sm text-blue-700 font-medium hover:underline">
              Sources and details <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- View Dedicated Lineage Page Banner -->
    <div class="mt-8 text-center">
      <a 
        href="/inspirations" 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-mono text-xs font-bold transition-all shadow-xs group">
        <span>Explore all {INSPIRATIONS.length} profiles and their sources</span>
        <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Bottom note on ecosystem collaboration -->
    <div class="mt-8 p-6 rounded-xl border border-blue-100 bg-blue-50/40 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-600 leading-relaxed">
        <strong class="text-slate-900 font-semibold block mb-0.5">Notice an inspiration or project missing?</strong>
        Suggest a source, share a case study or point out an attribution that needs correcting.
      </div>
      <a
        href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-800 font-mono text-xs font-semibold hover:bg-slate-50 transition-colors shrink-0 shadow-xs">
        Suggest a reference ↗
      </a>
    </div>

  </div>
</section>

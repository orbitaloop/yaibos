---
import { PILLARS } from '../data/spec';
---

<section id="principles" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-slate-50/40">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
        Six pillars
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed">
        Base keeps your context, skills, role agents and tools in open files. Cockpit adds a dashboard for execution and tracking. Team adds shared work and enforced permissions. The same six pillars apply across the three profiles.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PILLARS.map((pillar) => (
        <div class="rounded-xl p-6 border border-slate-200 bg-white flex flex-col">
          <span class="font-mono text-sm text-slate-400">{pillar.number}</span>
          <h3 class="mt-1 text-lg font-bold text-slate-900">{pillar.title}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">{pillar.why}</p>

          <h4 class="mt-5 text-xs font-semibold text-slate-900">Base [L1]</h4>
          <ul class="mt-2 space-y-1.5 text-sm text-slate-700">
            {pillar.core.map((req) => (
              <li class="flex gap-2"><span class="text-blue-600 shrink-0">✓</span><span>{req}</span></li>
            ))}
          </ul>

          <h4 class="mt-4 text-xs font-semibold text-slate-500">Optional layers</h4>
          <ul class="mt-2 space-y-1.5 text-sm text-slate-500">
            {pillar.later.map((req) => (
              <li class="flex gap-2"><span class="shrink-0">·</span><span>{req}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-10 text-sm text-slate-600">
      Exact requirements, levels and file formats are in the <a href="/spec" class="text-blue-600 font-medium hover:underline">full specification</a>.
    </p>
  </div>
</section>

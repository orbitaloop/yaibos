---
import { PILLARS } from '../data/spec';
---

<section id="principles" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/15 bg-white/5 text-xs font-mono text-slate-300 mb-3">
        <span>ARCHITECTURAL FOUNDATIONS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        The Six Core Pillars of FAIBOS
      </h2>
      <p class="mt-4 text-slate-400 text-base sm:text-lg">
        Designed from first principles to eliminate the operational, financial, and psychological friction of deploying autonomous AI inside small businesses.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PILLARS.map((pillar) => (
        <div class="tech-card rounded-xl p-6 border border-white/10 bg-[#0c0e14] flex flex-col justify-between hover:border-[#00f2fe]/40 transition-all group">
          <div>
            <!-- Number & Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-2xl font-bold text-[#00f2fe]/60 group-hover:text-[#00f2fe] transition-colors">
                {pillar.number}
              </span>
              <span class="px-2.5 py-0.5 rounded text-[11px] font-mono border border-white/10 bg-white/5 text-slate-300">
                {pillar.badge}
              </span>
            </div>

            <!-- Title & Tagline -->
            <h3 class="text-xl font-bold text-white group-hover:text-[#00f2fe] transition-colors">
              {pillar.title}
            </h3>
            <p class="text-xs font-mono text-[#00f2fe]/80 mt-1 mb-4">
              {pillar.tagline}
            </p>

            <!-- Problem vs Solution -->
            <div class="space-y-3 text-xs leading-relaxed">
              <div class="p-3 rounded bg-red-950/20 border border-red-900/30 text-slate-300">
                <strong class="text-red-400 font-mono block text-[10px] uppercase mb-1">The Friction:</strong>
                {pillar.problem}
              </div>
              <div class="p-3 rounded bg-emerald-950/20 border border-emerald-900/30 text-slate-300">
                <strong class="text-emerald-400 font-mono block text-[10px] uppercase mb-1">The Specification:</strong>
                {pillar.solution}
              </div>
            </div>
          </div>

          <!-- Technical Requirements List -->
          <div class="mt-6 pt-4 border-t border-white/5">
            <h4 class="text-[10px] font-mono text-slate-500 uppercase tracking-wider mb-2">
              Key Requirements:
            </h4>
            <ul class="space-y-1.5 text-[11px] text-slate-400 font-mono">
              {pillar.technicalRequirements.map((req) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-[#00f2fe] shrink-0">›</span>
                  <span>{req}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Read Full Specification CTA Banner -->
    <div class="mt-12 p-6 rounded-xl border border-[#00f2fe]/30 bg-[#00f2fe]/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-lg font-bold text-white">Looking for the formal technical schema?</h4>
        <p class="text-sm text-slate-400 mt-0.5">
          Read the complete draft RFC including YAML frontmatter specs, telemetry schemas, and sandboxing rules.
        </p>
      </div>
      <a
        href="/spec"
        class="px-5 py-2.5 rounded bg-[#00f2fe] text-black font-mono text-xs font-bold hover:bg-[#38bdf8] transition-colors shrink-0">
        READ COMPLETE SPECIFICATION →
      </a>
    </div>
  </div>
</section>

---
---

<section class="relative pt-16 pb-20 px-4 sm:px-6 lg:px-8 border-b border-white/10">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumb / Spec Status -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/15 bg-white/5 text-xs font-mono text-slate-300 mb-8">
      <span class="w-2 h-2 rounded-full bg-[#00f2fe] live-indicator"></span>
      <span class="text-white font-medium">OPEN SPECIFICATION v1.0</span>
      <span class="text-slate-500">|</span>
      <span class="text-slate-400">SOVEREIGN AI HARNESS STANDARD</span>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <!-- Left Hero Text -->
      <div class="lg:col-span-7">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight font-sans">
          The Sovereign AI Operating System for Small Business.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed font-light">
          No terminal commands. No Git merge conflicts. No unpredictable API token bills. FAIBOS unites 1-click SOP execution, Bring Your Own Subscription auth, and a sovereign team second brain into a clean, zero-friction cockpit.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
          <a
            href="/spec"
            class="px-6 py-3 rounded bg-[#00f2fe] text-black font-semibold hover:bg-[#38bdf8] transition-all shadow-[0_0_20px_rgba(0,242,254,0.3)]">
            READ SPECIFICATION v1.0 →
          </a>
          <a
            href="/implementations"
            class="px-6 py-3 rounded border border-white/20 bg-white/5 hover:bg-white/10 text-white transition-all">
            MARKET SCORECARD
          </a>
          <a
            href="#cockpit"
            class="px-6 py-3 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 transition-all flex items-center gap-2">
            <span>▶ TEST COCKPIT</span>
          </a>
        </div>

        <!-- Telemetry Attributes -->
        <div class="mt-12 pt-8 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono text-xs">
          <div>
            <span class="text-slate-500 block text-[11px]">// DATA LAYER</span>
            <span class="text-slate-200 font-medium">Local Markdown</span>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">// AUTH MODEL</span>
            <span class="text-slate-200 font-medium">BYOS (0 Token Shock)</span>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">// RUNTIME</span>
            <span class="text-slate-200 font-medium">1-Click Micro-Kernel</span>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">// LICENSE</span>
            <span class="text-slate-200 font-medium">CC-BY-4.0 Open Spec</span>
          </div>
        </div>
      </div>

      <!-- Right Architecture Visual Card -->
      <div class="lg:col-span-5">
        <div class="tech-card rounded-xl p-5 border border-white/15 bg-[#0c0e14]/90 shadow-2xl relative overflow-hidden">
          <!-- Terminal Title Bar -->
          <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 font-mono text-xs">
            <div class="flex items-center gap-2 text-slate-400">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 text-slate-300">faibos-runtime-spec.arch</span>
            </div>
            <span class="text-[10px] text-emerald-400 font-mono">STATUS: VALIDATED</span>
          </div>

          <!-- Architecture ASCII/Diagram -->
          <div class="font-mono text-[12px] leading-relaxed text-slate-300 space-y-3">
            <div class="p-2.5 rounded bg-white/5 border border-white/10">
              <span class="text-[#00f2fe] font-semibold">[ 1. PRESENTATION LAYER ]</span>
              <div class="text-slate-400 text-[11px] mt-1">
                • 1-Click SOP Visual Cards & Telemetry<br />
                • Rich Markdown Editor & Graph Navigator<br />
                • Duration Tracker & Audit Logs
              </div>
            </div>

            <div class="p-2.5 rounded bg-white/5 border border-white/10">
              <span class="text-emerald-400 font-semibold">[ 2. GOVERNANCE & AUTH ]</span>
              <div class="text-slate-400 text-[11px] mt-1">
                • Folder-level & File-level RBAC<br />
                • BYOS Auth (ChatGPT / Claude OAuth Bridge)<br />
                • Stage Gates: Assisted → Supervised → Autonomous
              </div>
            </div>

            <div class="p-2.5 rounded bg-white/5 border border-white/10">
              <span class="text-amber-400 font-semibold">[ 3. EXECUTION MICRO-KERNEL ]</span>
              <div class="text-slate-400 text-[11px] mt-1">
                • Agent Loop & Context Window Assembler<br />
                • Local Hybrid Memory (Vector + BM25)<br />
                • MCP & Tool Protocol Dispatcher
              </div>
            </div>

            <div class="p-2.5 rounded bg-white/5 border border-white/10">
              <span class="text-purple-400 font-semibold">[ 4. STORAGE & SOVEREIGNTY ]</span>
              <div class="text-slate-400 text-[11px] mt-1">
                • Plain Markdown Files (Local Disk / Git)<br />
                • Zero proprietary cloud database lock-in
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>SPEC: RFC-2026-FAIBOS-01</span>
            <a href="/spec" class="text-[#00f2fe] hover:underline">Full Spec & Schema →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

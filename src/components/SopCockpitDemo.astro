---
---

<section id="cockpit" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-white/10 bg-[#06070a]">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-xs font-mono text-emerald-400 mb-3">
        <span>PILLAR 02 LIVE SIMULATION</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        The 1-Click SOP Execution Cockpit
      </h2>
      <p class="mt-4 text-slate-400 text-base sm:text-lg">
        How non-technical team members interact with autonomous procedures: cards instead of commands, instant execution telemetry, and verified output manifests.
      </p>
    </div>

    <!-- The Cockpit UI Simulator -->
    <div class="tech-card rounded-2xl border border-white/15 bg-[#0a0c12] overflow-hidden shadow-2xl">
      <!-- Cockpit Bar -->
      <div class="px-6 py-4 border-b border-white/10 bg-[#0f121a] flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
        <div class="flex items-center gap-4">
          <span class="text-[#00f2fe] font-semibold">// WORKSPACE: SOLAR-INSTALLER-CORE</span>
          <span class="text-slate-500">|</span>
          <span class="text-slate-400">AUTH: BYOS (CLAUDE TEAM SESSION)</span>
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <span>RUNNING JOBS: <strong id="active-jobs-count" class="text-white">0</strong></span>
          <span class="text-emerald-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 live-indicator"></span>
            LOCAL RUNTIME READY
          </span>
        </div>
      </div>

      <!-- Main Cockpit Split -->
      <div class="grid lg:grid-cols-12 min-h-[480px]">
        <!-- Left: SOP Action Catalog (7 cols) -->
        <div class="lg:col-span-7 p-6 border-b lg:border-b-0 lg:border-r border-white/10 space-y-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-mono text-xs uppercase tracking-wider text-slate-400">
              Operational Procedures Catalog (3 Loaded)
            </h3>
            <span class="text-[11px] font-mono text-slate-500">Source: MD_VAULTS/5 SOP/</span>
          </div>

          <!-- SOP Card 1 -->
          <div class="sop-card p-4 rounded-xl border border-white/10 bg-[#0f121a] hover:border-[#00f2fe]/40 transition-all cursor-pointer" data-sop-id="solar-leads">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    STAGE 2: SUPERVISED
                  </span>
                  <span class="text-[11px] font-mono text-slate-400">Area: Lead Gen</span>
                </div>
                <h4 class="text-base font-semibold text-white">Solar Prospect Discovery & Rooftop Catastro Review</h4>
                <p class="text-xs text-slate-400 mt-1">
                  Discovers businesses in large industrial buildings, queries Spanish Catastro API for rooftop m2, and updates pipeline.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded bg-[#00f2fe] text-black font-mono text-xs font-bold hover:bg-[#38bdf8] transition-all shrink-0 flex items-center gap-1.5 shadow-[0_0_12px_rgba(0,242,254,0.25)]"
                data-sop="solar-leads">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: 2h ago (Duration: 48s)</span>
              <span>Owner: Maria (Sales Lead)</span>
            </div>
          </div>

          <!-- SOP Card 2 -->
          <div class="sop-card p-4 rounded-xl border border-white/10 bg-[#0f121a] hover:border-[#00f2fe]/40 transition-all cursor-pointer" data-sop-id="invoices-audit">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    STAGE 3: AUTONOMOUS
                  </span>
                  <span class="text-[11px] font-mono text-slate-400">Area: Accounting</span>
                </div>
                <h4 class="text-base font-semibold text-white">Monthly Invoices Audit & Bank Statement Reconciliation</h4>
                <p class="text-xs text-slate-400 mt-1">
                  Extracts tables from incoming vendor PDF invoices, verifies tax IDs, and matches lines against monthly bank CSVs.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded bg-white/10 text-white border border-white/20 font-mono text-xs font-bold hover:bg-white/20 transition-all shrink-0 flex items-center gap-1.5"
                data-sop="invoices-audit">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: Yesterday (Duration: 1m 12s)</span>
              <span>Owner: Samuel (Finance)</span>
            </div>
          </div>

          <!-- SOP Card 3 -->
          <div class="sop-card p-4 rounded-xl border border-white/10 bg-[#0f121a] hover:border-[#00f2fe]/40 transition-all cursor-pointer" data-sop-id="newsletter-sync">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    STAGE 1: ASSISTED
                  </span>
                  <span class="text-[11px] font-mono text-slate-400">Area: Marketing</span>
                </div>
                <h4 class="text-base font-semibold text-white">AI Tools Radar Discovery & Digest Newsletter Draft</h4>
                <p class="text-xs text-slate-400 mt-1">
                  Scans tracked GitHub repos and MCP tools, filters releases, drafts weekly Markdown summary, and prepares AgentMail delivery.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded bg-white/10 text-white border border-white/20 font-mono text-xs font-bold hover:bg-white/20 transition-all shrink-0 flex items-center gap-1.5"
                data-sop="newsletter-sync">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: 4 days ago (Duration: 2m 04s)</span>
              <span>Owner: Editorial Team</span>
            </div>
          </div>
        </div>

        <!-- Right: Real-time Telemetry & Execution Logs (5 cols) -->
        <div class="lg:col-span-5 p-6 bg-[#08090d] flex flex-col justify-between font-mono text-xs">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4">
              <span class="text-slate-400 font-semibold">// LIVE EXECUTION TELEMETRY</span>
              <span id="telemetry-status-badge" class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium text-[11px]">
                IDLE
              </span>
            </div>

            <!-- Telemetry Metrics Strip -->
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="p-3 rounded bg-white/5 border border-white/10">
                <span class="text-[10px] text-slate-500 block">ELAPSED TIME</span>
                <span id="telemetry-timer" class="text-lg font-bold text-white">00:00</span>
              </div>
              <div class="p-3 rounded bg-white/5 border border-white/10">
                <span class="text-[10px] text-slate-500 block">HUMAN TIME SAVED</span>
                <span id="telemetry-saved" class="text-lg font-bold text-emerald-400">0 min</span>
              </div>
            </div>

            <!-- Dynamic Console Steps -->
            <div class="space-y-2 mb-4">
              <span class="text-[10px] text-slate-500 block uppercase">Step Execution Stream:</span>
              <div id="telemetry-log-stream" class="h-48 overflow-y-auto space-y-1.5 p-3 rounded bg-[#06070a] border border-white/10 text-[11px] text-slate-300 font-mono">
                <p class="text-slate-500">// Ready. Click [▶ RUN] on any SOP card to simulate execution loop.</p>
              </div>
            </div>
          </div>

          <!-- Output Artifact Manifest -->
          <div id="output-manifest" class="pt-3 border-t border-white/10 text-[11px] text-slate-400">
            <span class="text-slate-500 block text-[10px] mb-1">PRODUCED ARTIFACT:</span>
            <span id="manifest-filename" class="text-slate-400">None yet</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const runButtons = document.querySelectorAll('.run-sop-btn');
    const statusBadge = document.getElementById('telemetry-status-badge');
    const timerDisplay = document.getElementById('telemetry-timer');
    const savedDisplay = document.getElementById('telemetry-saved');
    const logStream = document.getElementById('telemetry-log-stream');
    const manifestFilename = document.getElementById('manifest-filename');
    const activeJobs = document.getElementById('active-jobs-count');

    let timerInterval = null;

    const sopScenarios = {
      'solar-leads': {
        title: 'Solar Prospect Discovery',
        timeSaved: '45 min',
        artifact: '1 PROJECTS/Active Leads/2026-09-13-qualified-solar-leads.csv',
        steps: [
          'Initializing sandboxed runner with role: operations',
          'Connecting to BYOS Claude Team session auth bridge...',
          'Ingesting target postal codes in Vallès Occidental (08200 - 08228)',
          'Calling Catastro API: fetched 32 industrial cadastral parcels',
          'Reviewing rooftop surface area (> 800 m2 threshold passed)',
          'Writing qualified prospect table to local Markdown and CSV',
          'Execution complete. 32 qualified prospects ready for review.'
        ]
      },
      'invoices-audit': {
        title: 'Invoices & Bank Reconciliation',
        timeSaved: '60 min',
        artifact: '2 Areas/Finance/Audit/2026-08-reconciled-statement.csv',
        steps: [
          'Initializing sandboxed runner with role: finance_viewer',
          'Scanning 2 Areas/Finance/Invoices/ for new August PDF receipts',
          'Extracting vendor tax IDs, invoice numbers, and VAT amounts',
          'Loading Bank statement export (Qonto / BBVA CSV)',
          'Matching 48 statement lines against invoice amounts (100% matched)',
          'Flagging 0 anomalies. Packaging ready-to-sign bundle for accountant',
          'Execution complete. Monthly statement reconciled.'
        ]
      },
      'newsletter-sync': {
        title: 'AI Tools Radar Sync',
        timeSaved: '30 min',
        artifact: '3 RESOURCES/Newsletter/Drafts/radar-issue-42.md',
        steps: [
          'Initializing sandboxed runner with role: editorial',
          'Querying GitHub API for releases in 56 tracked harness repositories',
          'Filtering newly published dsh plugins and MCP adapters',
          'Synthesizing changelog summaries without AI fluff',
          'Drafting Markdown newsletter in second brain inbox',
          'Execution complete. Draft awaiting Samuel Michelot editorial sign-off.'
        ]
      }
    };

    runButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const sopKey = btn.getAttribute('data-sop');
        const scenario = sopScenarios[sopKey];
        if (!scenario) return;

        // Reset state
        clearInterval(timerInterval);
        logStream.innerHTML = '';
        statusBadge.textContent = 'RUNNING';
        statusBadge.className = 'px-2 py-0.5 rounded bg-[#00f2fe]/20 text-[#00f2fe] border border-[#00f2fe]/40 font-medium text-[11px] live-indicator';
        activeJobs.textContent = '1';
        manifestFilename.innerHTML = '<span class="text-slate-500">Generating output...</span>';
        savedDisplay.textContent = '0 min';

        let seconds = 0;
        timerDisplay.textContent = '00:00';
        timerInterval = setInterval(() => {
          seconds++;
          const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
          const secs = String(seconds % 60).padStart(2, '0');
          timerDisplay.textContent = `${mins}:${secs}`;
        }, 1000);

        // Play scenario steps
        scenario.steps.forEach((step, index) => {
          setTimeout(() => {
            const p = document.createElement('p');
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
            p.innerHTML = `<span class="text-slate-500">[${timeStr}]</span> <span class="text-slate-200">${step}</span>`;
            logStream.appendChild(p);
            logStream.scrollTop = logStream.scrollHeight;

            if (index === scenario.steps.length - 1) {
              clearInterval(timerInterval);
              statusBadge.textContent = 'SUCCESS';
              statusBadge.className = 'px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-medium text-[11px]';
              activeJobs.textContent = '0';
              savedDisplay.textContent = scenario.timeSaved;
              manifestFilename.innerHTML = `<span class="text-[#00f2fe] font-semibold">${scenario.artifact}</span>`;
            }
          }, (index + 1) * 650);
        });
      });
    });
  });
</script>

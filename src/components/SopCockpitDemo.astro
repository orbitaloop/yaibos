---
---

<section id="cockpit" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-200 bg-emerald-50 text-xs font-mono text-emerald-800 mb-3">
        <span>PILLAR 02 LIVE SIMULATION</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 font-sans">
        The 1-Click SOP Execution Cockpit (~ Skills for Business)
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed">
        How non-technical team members interact with autonomous procedures: visual cards instead of terminal commands, real-time execution telemetry, and verified output manifests. Standard Operating Procedures (SOPs) are the direct business equivalent of agent skills.
      </p>
    </div>

    <!-- REST API & Workflow Integration Callout -->
    <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/60 font-sans text-xs text-slate-700 mb-8 space-y-1.5 shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded bg-blue-600 text-white font-mono text-[10px] font-bold uppercase tracking-wider">REST API & Workflow Triggers</span>
          <span class="font-bold text-slate-900 text-xs sm:text-sm">Hybrid Human / AI Workflows (Asana, Trello, Linear, ERP)</span>
        </div>
        <div class="flex items-center gap-2 font-mono text-[11px] text-blue-800">
          <code class="bg-blue-100 px-1.5 py-0.5 rounded">POST /api/v1/sop/{'{id}'}/run</code>
          <span>·</span>
          <code class="bg-blue-100 px-1.5 py-0.5 rounded">yaibos://run?sop={'{id}'}</code>
        </div>
      </div>
      <p class="text-slate-600 leading-relaxed pt-1">
        In multi-step business workflows where some tasks are completed by humans and some by AI, every SOP can be triggered either visually in 1 click from the harness, or called via REST API and deep-link URLs. A team member in Asana, Trello, or an ERP can click an embedded SOP link directly on a task card to execute the procedure in 1 click in their harness, or an ERP webhook executes the AI step automatically once predecessor human tasks are signed off.
      </p>
    </div>

    <!-- The Cockpit UI Simulator Card -->
    <div class="elegant-card rounded-2xl border border-slate-200/90 bg-white overflow-hidden shadow-md">
      <!-- Cockpit Top Bar -->
      <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
        <div class="flex items-center gap-3">
          <span class="text-blue-700 font-bold">WORKSPACE: AI_ZONE (SMB-OPERATIONS-CORE)</span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-600">AUTH: BYOS (CLAUDE TEAM SESSION)</span>
        </div>
        <div class="flex items-center gap-4 text-slate-600">
          <span>RUNNING JOBS: <strong id="active-jobs-count" class="text-slate-900 font-bold">0</strong></span>
          <span class="text-emerald-700 flex items-center gap-1.5 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-600 live-indicator"></span>
            LOCAL RUNTIME READY
          </span>
        </div>
      </div>

      <!-- Main Cockpit Split -->
      <div class="grid lg:grid-cols-12 min-h-[480px]">
        <!-- Left: SOP Action Catalog (7 cols) -->
        <div class="lg:col-span-7 p-6 border-b lg:border-b-0 lg:border-r border-slate-200 space-y-4 bg-white">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-mono text-xs uppercase tracking-wider text-slate-500 font-semibold">
              Operational Procedures Catalog (3 Loaded: SOPs = Skills for Business)
            </h3>
            <span class="text-[11px] font-mono text-slate-400">Source: MD_VAULTS/5 SOP/</span>
          </div>

          <!-- SOP Card 1: B2B Lead Qualification -->
          <div class="sop-card p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-blue-400 hover:shadow-xs transition-all cursor-pointer" data-sop-id="b2b-lead-enrichment">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                    STAGE 2: SUPERVISED
                  </span>
                  <span class="text-[11px] font-mono text-slate-500">Area: Sales & Marketing</span>
                </div>
                <h4 class="text-base font-bold text-slate-900">B2B Inbound Lead Qualification & CRM Enrichment</h4>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  Extracts incoming inquiries, enriches company size and revenue via business registries, and updates CRM pipeline.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded-lg bg-blue-600 text-white font-mono text-xs font-bold hover:bg-blue-700 transition-all shrink-0 flex items-center gap-1.5 shadow-xs"
                data-sop="b2b-lead-enrichment">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-200/70 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: 2h ago (Duration: 48s)</span>
              <span>Owner: Maria (Sales Lead)</span>
            </div>
          </div>

          <!-- SOP Card 2: Accounting Reconciliation -->
          <div class="sop-card p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-blue-400 hover:shadow-xs transition-all cursor-pointer" data-sop-id="invoices-audit">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    STAGE 3: AUTONOMOUS
                  </span>
                  <span class="text-[11px] font-mono text-slate-500">Area: Accounting</span>
                </div>
                <h4 class="text-base font-bold text-slate-900">Monthly Invoices Audit & Bank Statement Reconciliation</h4>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  Extracts tables from incoming vendor PDF invoices, verifies tax IDs, and matches lines against monthly bank CSVs.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded-lg bg-slate-800 text-white hover:bg-slate-900 font-mono text-xs font-bold transition-all shrink-0 flex items-center gap-1.5 shadow-xs"
                data-sop="invoices-audit">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-200/70 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: Yesterday (Duration: 1m 12s)</span>
              <span>Owner: Samuel (Finance)</span>
            </div>
          </div>

          <!-- SOP Card 3: Support Triage -->
          <div class="sop-card p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-blue-400 hover:shadow-xs transition-all cursor-pointer" data-sop-id="support-triage">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                    STAGE 1: ASSISTED
                  </span>
                  <span class="text-[11px] font-mono text-slate-500">Area: Operations & Support</span>
                </div>
                <h4 class="text-base font-bold text-slate-900">Customer Support Ticket Triage & Draft Responses</h4>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  Ingests unassigned customer helpdesk tickets, categorizes priority, drafts contextual answers from product docs, and alerts on bugs.
                </p>
              </div>
              <button 
                type="button"
                class="run-sop-btn px-4 py-2 rounded-lg bg-slate-800 text-white hover:bg-slate-900 font-mono text-xs font-bold transition-all shrink-0 flex items-center gap-1.5 shadow-xs"
                data-sop="support-triage">
                <span>▶ RUN</span>
              </button>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-200/70 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>Last execution: 4 hours ago (Duration: 1m 40s)</span>
              <span>Owner: Support Team</span>
            </div>
          </div>
        </div>

        <!-- Right: Real-time Telemetry & Execution Logs (5 cols) -->
        <div class="lg:col-span-5 p-6 bg-slate-50 flex flex-col justify-between font-mono text-xs">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
              <span class="text-slate-700 font-bold">// LIVE EXECUTION TELEMETRY</span>
              <span id="telemetry-status-badge" class="px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-700 font-semibold text-[11px]">
                IDLE
              </span>
            </div>

            <!-- Telemetry Metrics Strip -->
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-xs">
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">ELAPSED TIME</span>
                <span id="telemetry-timer" class="text-xl font-bold text-slate-900">00:00</span>
              </div>
              <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-xs">
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">HUMAN TIME SAVED</span>
                <span id="telemetry-saved" class="text-xl font-bold text-emerald-700">0 min</span>
              </div>
            </div>

            <!-- Dynamic Console Steps -->
            <div class="space-y-2 mb-4">
              <span class="text-[10px] text-slate-500 block uppercase font-semibold">Step Execution Stream:</span>
              <div id="telemetry-log-stream" class="h-48 overflow-y-auto space-y-1.5 p-3.5 rounded-xl bg-slate-900 text-slate-200 border border-slate-800 text-[11px] font-mono leading-relaxed shadow-inner">
                <p class="text-slate-400">// Ready. Click [▶ RUN] on any SOP card to simulate live loop.</p>
              </div>
            </div>
          </div>

          <!-- Output Artifact Manifest -->
          <div id="output-manifest" class="pt-3 border-t border-slate-200 text-[11px] text-slate-600">
            <span class="text-slate-400 block text-[10px] uppercase font-semibold mb-1">PRODUCED ARTIFACT:</span>
            <span id="manifest-filename" class="text-slate-600 font-medium">None yet</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const runButtons = document.querySelectorAll('.run-sop-btn');
    const statusBadge = document.getElementById('telemetry-status-badge');
    const timerDisplay = document.getElementById('telemetry-timer');
    const savedDisplay = document.getElementById('telemetry-saved');
    const logStream = document.getElementById('telemetry-log-stream');
    const manifestFilename = document.getElementById('manifest-filename');
    const activeJobs = document.getElementById('active-jobs-count');

    let timerInterval = null;

    const sopScenarios = {
      'b2b-lead-enrichment': {
        title: 'B2B Lead Qualification',
        timeSaved: '45 min',
        artifact: '1 PROJECTS/Active Leads/2026-09-14-qualified-leads.csv',
        steps: [
          'Initializing sandboxed runner with role: sales_operator',
          'Connecting to BYOS Claude Team session auth bridge...',
          'Fetching 18 unassigned leads from inbound webhook queue',
          'Enriching company domain, size, and industry via business registries',
          'Applying qualification scoring criteria (ICP threshold passed: 14/18)',
          'Updating CRM pipeline and generating prospect summary table',
          'Execution complete. 14 qualified leads staged for sales team.'
        ]
      },
      'invoices-audit': {
        title: 'Invoices & Bank Reconciliation',
        timeSaved: '60 min',
        artifact: '2 Areas/Finance/Audit/2026-08-reconciled-statement.csv',
        steps: [
          'Initializing sandboxed runner with role: finance_viewer',
          'Scanning 2 Areas/Finance/Invoices/ for new August PDF receipts',
          'Extracting vendor tax IDs, invoice numbers, and VAT amounts',
          'Loading Bank statement export (Qonto / BBVA CSV)',
          'Matching 48 statement lines against invoice amounts (100% matched)',
          'Flagging 0 anomalies. Packaging ready-to-sign bundle for accountant',
          'Execution complete. Monthly statement reconciled.'
        ]
      },
      'support-triage': {
        title: 'Support Ticket Triage',
        timeSaved: '40 min',
        artifact: '2 ROLES/Support/2026-09-14-ticket-triage.md',
        steps: [
          'Initializing sandboxed runner with role: support_operator',
          'Ingesting 12 unassigned customer tickets from helpdesk queue',
          'Checking second brain product documentation and FAQs',
          'Categorizing: 9 standard questions, 2 billing queries, 1 urgent bug',
          'Drafting contextual resolution replies for the 9 standard tickets',
          'Escalating urgent bug to engineering team with error context',
          'Execution complete. Draft responses ready for human 1-click sign-off.'
        ]
      }
    };

    runButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const sopKey = btn.getAttribute('data-sop');
        const scenario = sopScenarios[sopKey];
        if (!scenario) return;

        // Reset state
        clearInterval(timerInterval);
        logStream.innerHTML = '';
        statusBadge.textContent = 'RUNNING';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 border border-blue-200 font-bold text-[11px] live-indicator';
        activeJobs.textContent = '1';
        manifestFilename.innerHTML = '<span class="text-slate-400">Generating output...</span>';
        savedDisplay.textContent = '0 min';

        let seconds = 0;
        timerDisplay.textContent = '00:00';
        timerInterval = setInterval(() => {
          seconds++;
          const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
          const secs = String(seconds % 60).padStart(2, '0');
          timerDisplay.textContent = `${mins}:${secs}`;
        }, 1000);

        // Play scenario steps
        scenario.steps.forEach((step, index) => {
          setTimeout(() => {
            const p = document.createElement('p');
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
            p.innerHTML = `<span class="text-slate-500">[${timeStr}]</span> <span class="text-slate-200">${step}</span>`;
            logStream.appendChild(p);
            logStream.scrollTop = logStream.scrollHeight;

            if (index === scenario.steps.length - 1) {
              clearInterval(timerInterval);
              statusBadge.textContent = 'SUCCESS';
              statusBadge.className = 'px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-[11px]';
              activeJobs.textContent = '0';
              savedDisplay.textContent = scenario.timeSaved;
              manifestFilename.innerHTML = `<span class="text-blue-700 font-semibold">${scenario.artifact}</span>`;
            }
          }, (index + 1) * 650);
        });
      });
    });
  });
</script>

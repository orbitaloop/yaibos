---
interface Props {
  activePage?: 'home' | 'spec' | 'implementations';
}

const { activePage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#08090d]/85 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Wordmark -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded border border-[#00f2fe]/40 bg-[#00f2fe]/10 flex items-center justify-center font-mono font-bold text-sm text-[#00f2fe] group-hover:border-[#00f2fe] transition-colors">
          Y
        </div>
        <div class="flex flex-col">
          <span class="font-mono font-bold text-base tracking-wider text-white group-hover:text-[#00f2fe] transition-colors">
            YAIBOS
          </span>
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest leading-none">
            Your AI Business OS
          </span>
        </div>
      </a>

      <!-- Status badge -->
      <div class="hidden sm:flex items-center gap-1.5 px-2 py-0.5 rounded border border-emerald-500/30 bg-emerald-500/10 font-mono text-[11px] text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 live-indicator"></span>
        <span>SPEC v1.0 ACTIVE</span>
      </div>
    </div>

    <!-- Navigation links -->
    <nav class="hidden md:flex items-center gap-6 font-mono text-xs text-slate-300">
      <a 
        href="/#principles" 
        class="hover:text-[#00f2fe] transition-colors py-1">
        // PRINCIPLES
      </a>
      <a 
        href="/#cockpit" 
        class="hover:text-[#00f2fe] transition-colors py-1">
        // 1-CLICK COCKPIT
      </a>
      <a 
        href="/implementations" 
        class={`hover:text-[#00f2fe] transition-colors py-1 ${activePage === 'implementations' ? 'text-[#00f2fe] border-b border-[#00f2fe]' : ''}`}>
        // IMPLEMENTATIONS
      </a>
      <a 
        href="/spec" 
        class={`hover:text-[#00f2fe] transition-colors py-1 ${activePage === 'spec' ? 'text-[#00f2fe] border-b border-[#00f2fe]' : ''}`}>
        // OPEN SPEC
      </a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-3">
      <a
        href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded border border-[#00f2fe]/40 bg-[#00f2fe]/10 hover:bg-[#00f2fe]/20 text-[#00f2fe] font-mono text-xs transition-all flex items-center gap-1.5">
        <span>TALK TO SAMUEL</span>
        <span class="text-[10px]" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://github.com/orbitaloop/yaibos"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-white/20 bg-white/5 hover:bg-white/10 text-white font-mono text-xs transition-colors">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GITHUB</span>
      </a>

      <a
        href="/spec"
        class="hidden lg:inline-flex px-3 py-1.5 rounded bg-white text-black font-mono text-xs font-semibold hover:bg-slate-200 transition-colors">
        SPEC.md
      </a>
    </div>
  </div>
</header>

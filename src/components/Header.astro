---
interface Props {
  activePage?: 'home' | 'spec' | 'implementations' | 'about' | 'why';
}

const { activePage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Wordmark -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg border border-blue-600/30 bg-blue-50 flex items-center justify-center font-mono font-bold text-sm text-blue-600 group-hover:border-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-xs">
          Y
        </div>
        <div class="flex flex-col">
          <span class="font-mono font-bold text-base tracking-wider text-slate-900 group-hover:text-blue-600 transition-colors">
            YAIBOS
          </span>
          <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest leading-none">
            Your AI Business OS
          </span>
        </div>
      </a>

      <!-- Status badge -->
      <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-emerald-200 bg-emerald-50 font-mono text-[11px] text-emerald-700">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 live-indicator"></span>
        <span class="font-medium">SPEC v1.0 ACTIVE</span>
      </div>
    </div>

    <!-- Navigation links -->
    <nav class="hidden xl:flex items-center gap-5 font-mono text-xs text-slate-600">
      <a 
        href="/why" 
        class={`hover:text-blue-600 transition-colors py-1 ${activePage === 'why' ? 'text-blue-600 font-semibold border-b-2 border-blue-600' : ''}`}>
        WHY YAIBOS
      </a>
      <a 
        href="/#how-it-works" 
        class="hover:text-blue-600 transition-colors py-1">
        HOW IT WORKS
      </a>
      <a 
        href="/#principles" 
        class="hover:text-blue-600 transition-colors py-1">
        PRINCIPLES
      </a>
      <a 
        href="/#cockpit" 
        class="hover:text-blue-600 transition-colors py-1">
        1-CLICK COCKPIT
      </a>
      <a 
        href="/#inspirations" 
        class="hover:text-blue-600 transition-colors py-1">
        INSPIRATIONS
      </a>
      <a 
        href="/implementations" 
        class={`hover:text-blue-600 transition-colors py-1 ${activePage === 'implementations' ? 'text-blue-600 font-semibold border-b-2 border-blue-600' : ''}`}>
        IMPLEMENTATIONS
      </a>
      <a 
        href="/spec" 
        class={`hover:text-blue-600 transition-colors py-1 ${activePage === 'spec' ? 'text-blue-600 font-semibold border-b-2 border-blue-600' : ''}`}>
        OPEN SPEC
      </a>
      <a 
        href="/about" 
        class={`hover:text-blue-600 transition-colors py-1 ${activePage === 'about' ? 'text-blue-600 font-semibold border-b-2 border-blue-600' : ''}`}>
        ABOUT
      </a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-2.5">
      <a
        href="/why"
        class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-mono text-xs font-medium transition-colors">
        THE EQUATION
      </a>

      <a
        href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-lg border border-blue-600/30 bg-blue-50 hover:bg-blue-600 hover:text-white text-blue-700 font-mono text-xs font-semibold transition-all flex items-center gap-1.5 shadow-xs">
        <span>TALK TO SAMUEL</span>
        <span class="text-[10px]" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://github.com/orbitaloop/yaibos"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-mono text-xs transition-colors">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GITHUB</span>
      </a>
    </div>
  </div>
</header>

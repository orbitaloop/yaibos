---
---

<section id="how-it-works" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-slate-50/50">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-mono text-blue-700 mb-3">
        <span>ARCHITECTURE IN ACTION</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 font-sans">
        How the AI OS Actually Works
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed">
        No complicated cloud installations. No proprietary vendor databases. Here is how any modern AI agent harness turns your local directory into an autonomous business operating system.
      </p>
    </div>

    <!-- ILLUSTRATION 1: Connecting the Harness to the AI OS -->
    <div class="mb-16 elegant-card rounded-2xl p-6 sm:p-10 border border-slate-200/90 bg-white shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-100 mb-8">
        <div>
          <span class="text-xs font-mono text-blue-600 font-semibold uppercase tracking-wider block">
            Core Connection Model
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">
            Connect Any AI Harness with One Directory Path
          </h3>
        </div>
        <div class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 font-mono text-xs">
          Zero Configuration Drift
        </div>
      </div>

      <!-- The Desktop Harness Window Mockup (Codex / Antigravity Style) -->
      <div class="max-w-3xl mx-auto mb-10">
        <div class="rounded-2xl border border-slate-200/90 bg-slate-50/70 p-4 sm:p-6 shadow-md font-sans">
          
          <!-- App Header Strip -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
              <span class="ml-2 text-xs font-mono font-bold text-slate-700">Desktop AI Harness</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full font-semibold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 live-indicator"></span>
                ACTIVE WORKSPACE
              </span>
            </div>
          </div>

          <!-- Project Directory Selector (Desktop Codex Style) -->
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="text-slate-500 font-medium">Change the project for this chat</span>
              <span class="px-2 py-0.5 rounded bg-slate-200/80 border border-slate-300 text-[11px] font-mono text-slate-600 font-medium">⌥⇧⌘O</span>
            </div>

            <!-- Active Project Directory Pill Badge -->
            <div class="flex items-center">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-200/90 border border-slate-300 text-slate-800 font-mono text-xs font-semibold shadow-2xs">
                <span class="w-4 h-4 rounded-full bg-slate-400/50 text-slate-700 flex items-center justify-center text-[10px] font-bold">✕</span>
                <span>AI_ZONE</span>
              </div>
            </div>

            <!-- Desktop Prompt Box -->
            <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm space-y-4">
              <div class="text-slate-400 text-sm font-sans flex items-center gap-1">
                <span class="text-slate-700 font-normal">Do anything</span>
                <span class="w-0.5 h-4 bg-slate-800 animate-pulse inline-block"></span>
              </div>

              <!-- Prompt Bottom Toolbar -->
              <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-3">
                  <button type="button" class="w-7 h-7 rounded-lg border border-slate-200 hover:bg-slate-50 flex items-center justify-center text-slate-600 font-bold text-sm">
                    +
                  </button>
                  <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-slate-200 bg-slate-50 text-slate-600 font-mono text-[11px]">
                    <span>⏱</span>
                    <span>Approve for me</span>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <div class="px-2.5 py-1 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 font-mono text-[11px] font-medium flex items-center gap-1">
                    <span>5.6 Terra High</span>
                    <span class="text-[9px] text-slate-400">▼</span>
                  </div>
                  <div class="w-7 h-7 rounded-lg border border-slate-200 hover:bg-slate-50 flex items-center justify-center text-slate-600 text-xs">
                    🎙️
                  </div>
                  <div class="w-7 h-7 rounded-full bg-slate-700 text-white flex items-center justify-center font-bold text-xs shadow-xs">
                    ↑
                  </div>
                </div>
              </div>
            </div>

            <!-- Workspace Mounted Telemetry Banner -->
            <div class="p-3.5 rounded-xl border border-blue-200 bg-blue-50/70 text-blue-900 font-mono text-xs space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-bold flex items-center gap-1.5 text-blue-950">
                  <span class="text-blue-600">✓</span> Workspace Mounted: <code class="bg-blue-100 px-1.5 py-0.5 rounded text-blue-900">~/AI_ZONE</code>
                </span>
                <span class="text-[10px] uppercase font-semibold text-blue-700 bg-blue-100/80 px-2 py-0.5 rounded">
                  Root Nervous System Loaded
                </span>
              </div>
              <div class="text-[11px] text-slate-600 space-y-0.5 pt-1">
                <div>• Ingested operating directives from <code class="text-slate-800 font-semibold">AGENTS.md</code></div>
                <div>• Discovered 1-click business procedures in <code class="text-slate-800 font-semibold">5 SOP/</code> (~ skills for business)</div>
                <div>• Mounted external tools from <code class="text-slate-800 font-semibold">0 AI Tools Lists.md</code> via MCP</div>
                <div>• Connected to Team Second Brain in <code class="text-slate-800 font-semibold">MD_VAULTS/sam-vault</code></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Connecting Flow Arrows -->
      <div class="flex justify-center mb-6">
        <div class="flex flex-col items-center">
          <svg class="w-6 h-8 text-blue-600 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
          <span class="font-mono text-[11px] font-semibold text-slate-500 uppercase tracking-widest mt-1">
            Instantly Unlocks 3 Integrated Layers
          </span>
        </div>
      </div>

      <!-- Below: The 3 Core Connections -->
      <div class="grid md:grid-cols-3 gap-6">
        
        <!-- Connection 1: Second Brain -->
        <div class="p-6 rounded-xl border border-blue-100 bg-blue-50/40 hover:bg-blue-50/70 transition-all">
          <div class="w-10 h-10 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-lg mb-4 shadow-xs">
            🧠
          </div>
          <div class="flex items-center justify-between mb-1">
            <h4 class="text-base font-bold text-slate-900">1. Second Brain</h4>
            <span class="text-[10px] font-mono text-blue-700 font-semibold uppercase">Memory & PKM</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-sans mb-3">
            Open Markdown files in your vault. Contains company guidelines, customer records, and <code class="text-blue-900 font-mono">AGENTS.md</code> rules.
          </p>
          <div class="text-[11px] font-mono text-slate-500 pt-3 border-t border-blue-100/80 space-y-1">
            <div>• Human-editable in Obsidian</div>
            <div>• Zero proprietary cloud lock-in</div>
            <div>• Full data sovereignty</div>
          </div>
        </div>

        <!-- Connection 2: Tools & Integrations -->
        <div class="p-6 rounded-xl border border-emerald-100 bg-emerald-50/40 hover:bg-emerald-50/70 transition-all">
          <div class="w-10 h-10 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-lg mb-4 shadow-xs">
            ⚡
          </div>
          <div class="flex items-center justify-between mb-1">
            <h4 class="text-base font-bold text-slate-900">2. External Tools</h4>
            <span class="text-[10px] font-mono text-emerald-700 font-semibold uppercase">Real-World Action</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-sans mb-3">
            Model Context Protocol (MCP) servers, local scripts, billing APIs, CRM hooks, and sandboxed file operations.
          </p>
          <div class="text-[11px] font-mono text-slate-500 pt-3 border-t border-emerald-100/80 space-y-1">
            <div>• Standardized MCP adapters</div>
            <div>• Local shell & script execution</div>
            <div>• Controlled network boundaries</div>
          </div>
        </div>

        <!-- Connection 3: SOPs & Procedures -->
        <div class="p-6 rounded-xl border border-amber-100 bg-amber-50/40 hover:bg-amber-50/70 transition-all">
          <div class="w-10 h-10 rounded-lg bg-amber-600 text-white flex items-center justify-center font-bold text-lg mb-4 shadow-xs">
            📋
          </div>
          <div class="flex items-center justify-between mb-1">
            <h4 class="text-base font-bold text-slate-900">3. Business SOPs</h4>
            <span class="text-[10px] font-mono text-amber-700 font-semibold uppercase">Skills for Business</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-sans mb-3">
            Procedures written in standard Markdown (<code class="text-amber-900 font-mono">5 SOP/</code>) with frontmatter parameters, timeout caps, and output manifests. SOPs are the direct equivalent of skills for business.
          </p>
          <div class="text-[11px] font-mono text-slate-500 pt-3 border-t border-amber-100/80 space-y-1">
            <div>• 1-Click execution from UI</div>
            <div>• Assisted, supervised, autonomous</div>
            <div>• Verified output manifests</div>
          </div>
        </div>

      </div>
    </div>

    <!-- ILLUSTRATION 2: 1-Click SOPs vs Unstructured Prompting -->
    <div class="grid lg:grid-cols-2 gap-8 mb-16 items-stretch">
      
      <!-- The Bad Way: Chaotic Prompts -->
      <div class="p-6 sm:p-8 rounded-2xl border border-red-200 bg-red-50/20 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-red-100 text-red-700 border border-red-200">
              TRADITIONAL APPROACH
            </span>
            <span class="text-red-400 font-mono text-xs">High Friction</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            The Chaotic Prompting Trap
          </h3>
          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            Forcing non-technical team members to craft raw prompts in consumer chat windows leads to silent failures and expensive mistakes.
          </p>

          <div class="space-y-3 font-mono text-xs">
            <div class="p-3 rounded-lg bg-white border border-red-200 text-slate-700 flex items-start gap-2">
              <span class="text-red-500 font-bold shrink-0">✕</span>
              <span><strong>No standard inputs:</strong> Every employee writes different prompts with unpredictable output formats.</span>
            </div>
            <div class="p-3 rounded-lg bg-white border border-red-200 text-slate-700 flex items-start gap-2">
              <span class="text-red-500 font-bold shrink-0">✕</span>
              <span><strong>Copy-paste vulnerability:</strong> Manual copy-pasting of customer data and invoices into cloud chat windows.</span>
            </div>
            <div class="p-3 rounded-lg bg-white border border-red-200 text-slate-700 flex items-start gap-2">
              <span class="text-red-500 font-bold shrink-0">✕</span>
              <span><strong>Zero telemetry:</strong> No duration tracking, no verified output logs, and no record of what was done.</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-red-200/60 text-xs font-mono text-red-600 font-medium">
          Result: Inconsistent quality, high anxiety, and runaway token bills.
        </div>
      </div>

      <!-- The YAIBOS Way: 1-Click SOPs -->
      <div class="p-6 sm:p-8 rounded-2xl border border-emerald-200 bg-emerald-50/20 flex flex-col justify-between shadow-xs">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
              THE YAIBOS STANDARD
            </span>
            <span class="text-emerald-600 font-mono text-xs">Zero Friction</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            Deterministic 1-Click SOP Buttons (Skills for Business)
          </h3>
          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            Operational procedures are declared once in versioned Markdown and executed with a single click, with full human oversight.
          </p>

          <div class="space-y-3 font-mono text-xs">
            <div class="p-3 rounded-lg bg-white border border-emerald-200 text-slate-700 flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong>Repeatable cards:</strong> Procedures live as visual cards. Anyone on the team can run them safely.</span>
            </div>
            <div class="p-3 rounded-lg bg-white border border-emerald-200 text-slate-700 flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong>Real-time telemetry:</strong> Every execution tracks duration, human minutes saved, and status logs.</span>
            </div>
            <div class="p-3 rounded-lg bg-white border border-emerald-200 text-slate-700 flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong>Verified manifests:</strong> The agent writes output directly to local files and records an immutable log.</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-emerald-200/60 text-xs font-mono text-emerald-700 font-medium">
          Result: Low stress, predictable operations, and durable company leverage.
        </div>
      </div>

    </div>

    <!-- ILLUSTRATION 3: Multi-User Second Brain with RBAC -->
    <div class="elegant-card rounded-2xl p-6 sm:p-8 border border-slate-200 bg-white">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-mono text-blue-600 font-semibold uppercase tracking-wider block">
            Team Governance
          </span>
          <h3 class="text-xl font-bold text-slate-900 mt-0.5">
            Team Second Brain with Role-Based Access Control (RBAC)
          </h3>
        </div>
        <div class="text-xs font-mono text-slate-500">
          Source of truth: Local Markdown files
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4 font-mono text-xs">
        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-slate-900">Founder & Admin</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 text-blue-700">FULL ACCESS</span>
          </div>
          <p class="text-[11px] text-slate-600 font-sans leading-relaxed mb-2">
            Reads all areas. Exclusive approval on banking, strategy, and SOP modifications.
          </p>
          <div class="text-[10px] text-slate-500">
            • Scope: <code class="text-slate-800">/</code> (All folders)<br/>
            • Can modify core blueprints
          </div>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-slate-900">Sales & Marketing</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">SCOPED ACCESS</span>
          </div>
          <p class="text-[11px] text-slate-600 font-sans leading-relaxed mb-2">
            Runs Lead Qualification and CRM Enrichment SOPs. Writes qualified contacts to CRM only.
          </p>
          <div class="text-[10px] text-slate-500">
            • Scope: <code class="text-slate-800">1 PROJECTS/Leads/</code><br/>
            • Read-only on accounting files
          </div>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-slate-900">Operations & Finance</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800">SCOPED ACCESS</span>
          </div>
          <p class="text-[11px] text-slate-600 font-sans leading-relaxed mb-2">
            Runs Invoices Audit SOP. Reconciles receipts against bank statements.
          </p>
          <div class="text-[10px] text-slate-500">
            • Scope: <code class="text-slate-800">2 Areas/Finance/</code><br/>
            • Locked against unauthorized code changes
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

---
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80 bg-white">
  <div class="max-w-5xl mx-auto">
    <div class="elegant-card rounded-2xl p-8 sm:p-12 border border-blue-200 bg-gradient-to-br from-blue-50/40 via-white to-slate-50 relative overflow-hidden shadow-sm">
      <div class="relative z-10 grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-mono text-blue-700 mb-4">
            <span>SOVEREIGN ASYNC CONTACT</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-sans">
            Direct Line to Samuel Michelot
          </h2>

          <p class="mt-4 text-slate-600 text-sm sm:text-base leading-relaxed font-sans">
            Have feedback on the YAIBOS specification, want to propose a new implementation for the scorecard, or exploring a sovereign AI harness for your business?
          </p>

          <p class="mt-2 text-slate-500 text-xs sm:text-sm font-sans">
            Leave an asynchronous video, voice note, or text message through MyVideoAsk. No calendar friction, zero meeting fatigue.
          </p>

          <!-- 3 Channels Badges -->
          <div class="mt-6 flex flex-wrap gap-2.5 font-mono text-xs">
            <div class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 flex items-center gap-2 text-slate-700 shadow-2xs">
              <span>📹</span>
              <span>Webcam Video</span>
            </div>
            <div class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 flex items-center gap-2 text-slate-700 shadow-2xs">
              <span>🎙️</span>
              <span>Voice Note</span>
            </div>
            <div class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 flex items-center gap-2 text-slate-700 shadow-2xs">
              <span>💬</span>
              <span>Text & Calendly</span>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="https://contact.samuelmichelot.com/?lang=en&source_site=yaibos"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-xs">
              <span>START VIDEO OR AUDIO MESSAGE</span>
              <span class="text-xs" aria-hidden="true">↗</span>
            </a>

            <span class="text-xs font-mono text-slate-400">
              Powered by sovereign Cloudflare Worker
            </span>
          </div>
        </div>

        <!-- Right Side Preview Visual -->
        <div class="lg:col-span-5 font-mono text-xs">
          <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-4 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 text-slate-500 text-[11px]">
              <span class="font-semibold">contact.samuelmichelot.com</span>
              <span class="text-emerald-700 font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 live-indicator"></span>
                ONLINE
              </span>
            </div>

            <div class="space-y-2 font-sans">
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-100 text-xs text-slate-700">
                <span class="text-slate-400 block text-[10px] font-mono uppercase font-semibold mb-0.5">Step 1: Introduction</span>
                <span>Short greeting video explaining the project scope and context.</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-100 text-xs text-slate-700">
                <span class="text-slate-400 block text-[10px] font-mono uppercase font-semibold mb-0.5">Step 2: Async Recording</span>
                <span>Record up to 5 minutes of webcam video, audio, or write text.</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-100 text-xs text-slate-700">
                <span class="text-slate-400 block text-[10px] font-mono uppercase font-semibold mb-0.5">Step 3: Direct Response</span>
                <span>Automatic sync to Samuel's second brain, response within 24 hours.</span>
              </div>
            </div>

            <div class="pt-2 text-[11px] text-slate-400 text-center font-sans">
              Response typically within 24 hours during business days.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

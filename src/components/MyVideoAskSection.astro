---
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 border-b border-white/10 bg-[#06070a]">
  <div class="max-w-5xl mx-auto">
    <div class="tech-card rounded-2xl p-8 sm:p-12 border border-[#00f2fe]/30 bg-[#0c0e14]/90 relative overflow-hidden shadow-2xl">
      <!-- Background subtle glow -->
      <div class="pointer-events-none absolute -right-20 -bottom-20 w-80 h-80 bg-[#00f2fe]/10 rounded-full blur-3xl"></div>

      <div class="relative z-10 grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#00f2fe]/30 bg-[#00f2fe]/10 text-xs font-mono text-[#00f2fe] mb-4">
            <span>SOVEREIGN ASYNC CONTACT</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
            Direct Line to Samuel Michelot
          </h2>

          <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
            Have feedback on the FAIBOS specification, want to propose a new implementation for the scorecard, or exploring a sovereign AI harness for your small business?
          </p>

          <p class="mt-2 text-slate-400 text-sm">
            Leave an asynchronous video, audio note, or text message through MyVideoAsk. No calendar friction, no spam.
          </p>

          <!-- 3 Channels Badges -->
          <div class="mt-6 flex flex-wrap gap-3 font-mono text-xs">
            <div class="px-3 py-1.5 rounded bg-white/5 border border-white/10 flex items-center gap-2 text-slate-200">
              <span>📹</span>
              <span>Webcam Video</span>
            </div>
            <div class="px-3 py-1.5 rounded bg-white/5 border border-white/10 flex items-center gap-2 text-slate-200">
              <span>🎙️</span>
              <span>Voice Note</span>
            </div>
            <div class="px-3 py-1.5 rounded bg-white/5 border border-white/10 flex items-center gap-2 text-slate-200">
              <span>💬</span>
              <span>Text & Calendly</span>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="https://contact.samuelmichelot.com/?lang=en&source_site=faibos"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded bg-[#00f2fe] text-black font-mono text-sm font-bold hover:bg-[#38bdf8] transition-all flex items-center gap-2 shadow-[0_0_20px_rgba(0,242,254,0.3)]">
              <span>START VIDEO / AUDIO MESSAGE</span>
              <span class="text-xs" aria-hidden="true">↗</span>
            </a>

            <span class="text-xs font-mono text-slate-500">
              Powered by sovereign Cloudflare Worker
            </span>
          </div>
        </div>

        <!-- Right Side Preview Visual -->
        <div class="lg:col-span-5 font-mono text-xs">
          <div class="p-5 rounded-xl border border-white/10 bg-[#08090d] space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-white/10 text-slate-400 text-[11px]">
              <span>contact.samuelmichelot.com</span>
              <span class="text-emerald-400">ONLINE</span>
            </div>

            <div class="space-y-2">
              <div class="p-3 rounded bg-white/5 border border-white/5 text-[11px] text-slate-300">
                <span class="text-slate-500 block text-[10px] uppercase">Step 1: Introduction</span>
                <span>Short greeting video explaining the project scope & goals.</span>
              </div>
              <div class="p-3 rounded bg-white/5 border border-white/5 text-[11px] text-slate-300">
                <span class="text-slate-500 block text-[10px] uppercase">Step 2: Async Recording</span>
                <span>Record up to 5 minutes of webcam video, high-fidelity audio, or text.</span>
              </div>
              <div class="p-3 rounded bg-white/5 border border-white/5 text-[11px] text-slate-300">
                <span class="text-slate-500 block text-[10px] uppercase">Step 3: Direct Response</span>
                <span>Automatic Supabase + R2 sync, instant notification to Samuel.</span>
              </div>
            </div>

            <div class="pt-2 text-[10px] text-slate-500 text-center">
              Response typically within 24 hours during business days.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
